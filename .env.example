# Copy to .env.local (git-ignored) and fill in from your Firebase project settings
# (Project settings > General > Your apps > Web app config). Without these, cloud save is off.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Google Cloud > Credentials > "Web client" OAuth client ID (used by Google sign-in on Android).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# AdMob (README, Ads). Without these, Google's test ads are used. App IDs need a new build;
# ad unit IDs are used only in release builds (development always shows test ads).
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED=
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL=
EXPO_PUBLIC_ADMOB_IOS_REWARDED=
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL=
